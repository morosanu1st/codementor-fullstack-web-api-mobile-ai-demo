# Copy to api/.env and fill in. Without LLM_API_KEY the API answers in mock mode.
PORT=3000
# Any OpenAI-compatible Chat Completions endpoint works (OpenAI, Azure OpenAI proxy, OpenRouter, Groq, local Ollama /v1 ...)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=15000
# Comma-separated list of allowed browser origins for CORS ("*" for local dev)
CORS_ORIGIN=*
